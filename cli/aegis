#!/usr/bin/env python3
"""
Command line interface for the AEGIS security framework.
"""

import sys
import argparse
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parent.parent
if str(PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(PROJECT_ROOT))

from scripts.aegis_scan import scan_target
from scripts.aegis_audit import execute_host_audit
from scripts.aegis_triage import parse_and_triage
from scripts.aegis_report import generate_markdown_report

VERSION = "2.0.0"


def cmd_scan(args):
    findings = scan_target(args.target)
    print(f"Target:   {Path(args.target).resolve()}")
    print(f"Findings: {len(findings)}\n")

    if not findings:
        print("[OK] Clean audit: no secrets or AST flaws detected.\n")
    else:
        for f in findings:
            sev = f["severity"]
            color = "\033[91m" if sev == "CRITICAL" else ("\033[93m" if sev == "HIGH" else "\033[94m")
            reset = "\033[0m"
            print(f"[{color}{sev:<8}{reset}] {f['rule']} [{f.get('cwe', 'CWE-798')}]")
            print(f"  Location:    {f['file']}:{f['line']}")
            print(f"  Snippet:     {f['preview']}")
            print(f"  Context:     {f['context']}")
            print(f"  Remediation: \033[36m{f.get('remediation', '')}\033[0m")
            print("-" * 75)

        if args.fail_on_findings:
            sys.exit(1)


def cmd_audit(args):
    res = execute_host_audit()
    print(f"Host:       {res['hostname']}")
    print(f"Score:      {res['score']}/100 (Grade: {res['grade']})")
    print(f"Checks:     {res['checks_total']}\n")

    print(f"{'DOMAIN':<20} {'STATUS':<8} {'SEVERITY':<10} {'CHECK':<30} {'DETAILS'}")
    print("=" * 95)
    for c in res["checks"]:
        st = c["status"]
        st_color = "\033[92mPASS\033[0m" if st == "PASS" else ("\033[93mWARN\033[0m" if st == "WARN" else "\033[91mFAIL\033[0m")
        print(f"{c['domain']:<20} {st_color:<17} {c['severity']:<10} {c['check']:<30} {c['detail']}")
    print("\n")


def cmd_triage(args):
    res = parse_and_triage(Path(args.logfile))
    log_type = res.get("log_type", "auth")
    print(f"Log Classification: {log_type.upper()}")

    if log_type == "auth":
        incidents = res.get("correlated_incidents", [])
        print(f"Correlated Incidents: {len(incidents)}")
        print(f"Sudo Violations:      {len(res.get('sudo_violations', []))}\n")

        for inc in incidents:
            color = "\033[91m" if inc["severity"] == "CRITICAL" else "\033[93m"
            reset = "\033[0m"
            print(f"[{color}{inc['severity']}{reset}] {inc['summary']}")
            print(f"  Attacker Origin:  {inc['ip']}")
            print(f"  MITRE ATT&CK:     {inc['mitre']['technique_id']} ({inc['mitre']['technique_name']})")
            print(f"  Targeted Users:   {', '.join(inc['targeted_users'])}")
            print(f"  Timeline Window:  {inc['first_seen']} -> {inc['last_seen']}")
            print("-" * 75)

    elif log_type == "web":
        print(f"Requests: {res['total_requests']}")
        print(f"Scanners: {sum(res['scanner_activity'].values())}")
        print(f"Probes:   {res['exploit_probes_count']}\n")

    if res.get("containment_firewall_rules"):
        print("Containment Rules:")
        for rule in res["containment_firewall_rules"][:4]:
            print(f"  \033[36m{rule}\033[0m")
    print("\n")


def cmd_report(args):
    scan_data = {"findings": scan_target(args.scan_path)} if args.scan_path else None
    audit_data = execute_host_audit() if args.audit else None
    triage_data = parse_and_triage(Path(args.log_file)) if args.log_file else None

    report_md = generate_markdown_report(scan_data, audit_data, triage_data)
    out_file = Path(args.out)
    out_file.write_text(report_md, encoding="utf-8")
    print(f"[OK] Report written: {out_file.resolve()}")


def cmd_info(args):
    print(f"AEGIS Core Engine v{VERSION}")
    print("Frameworks: NIST SP 800-61 Rev. 2, MITRE ATT&CK v14, CIS, OWASP Top 10:2021, CVSS v3.1")
    print("Engines:    scan, audit, triage, report\n")


def main():
    parser = argparse.ArgumentParser(prog="aegis", description="AEGIS Security Architecture & Hardening Toolkit")
    parser.add_argument("--version", action="version", version=f"AEGIS {VERSION}")
    sub = parser.add_subparsers(dest="subcommand", help="Command")

    p_scan = sub.add_parser("scan", help="Run SAST and secret scan")
    p_scan.add_argument("target", nargs="?", default=".", help="Target path")
    p_scan.add_argument("--fail-on-findings", action="store_true", help="Exit code 1 on findings")
    p_scan.set_defaults(func=cmd_scan)

    p_audit = sub.add_parser("audit", help="Run host posture audit")
    p_audit.set_defaults(func=cmd_audit)

    p_triage = sub.add_parser("triage", help="Triage log artifacts")
    p_triage.add_argument("logfile", help="Log path")
    p_triage.set_defaults(func=cmd_triage)

    p_rep = sub.add_parser("report", help="Generate audit report")
    p_rep.add_argument("--scan-path", help="Scan path")
    p_rep.add_argument("--audit", action="store_true", default=True, help="Include host audit")
    p_rep.add_argument("--log-file", help="Log path")
    p_rep.add_argument("--out", "-o", default="aegis_security_report.md", help="Output file")
    p_rep.set_defaults(func=cmd_report)

    p_info = sub.add_parser("info", help="Show system info")
    p_info.set_defaults(func=cmd_info)

    args = parser.parse_args()
    if hasattr(args, "func"):
        args.func(args)
    else:
        cmd_info(None)


if __name__ == "__main__":
    main()
