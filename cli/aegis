#!/usr/bin/env python3
"""AEGIS CLI - improved minimal entrypoint"""
import sys
import argparse
from pathlib import Path

BANNER = r"""
╔══════════════════════╗
║       AEGIS AI       ║
║ Cyber Intelligence   ║
╚══════════════════════╝
"""

VERSION = "0.1.0"


def cmd_info(args):
    print(BANNER)
    print(f"Version: {VERSION}\n")
    print("Model:\n - Qwen Local (placeholder)\n")
    print("Memory:\n - Enabled (placeholder)\n")
    print("Modules:\n - Analyzer\n - Knowledge\n - Reporter\n")


def cmd_run(args):
    print("Starting AEGIS (placeholder)...")
    # TODO: start API or local services


def main(argv=None):
    parser = argparse.ArgumentParser(prog="aegis")
    parser.add_argument("--version", action="store_true", help="Show version and exit")
    sub = parser.add_subparsers(dest="cmd")

    p_info = sub.add_parser("info", help="Show system info")
    p_info.set_defaults(func=cmd_info)

    p_run = sub.add_parser("run", help="Run local stack (placeholder)")
    p_run.set_defaults(func=cmd_run)

    args = parser.parse_args(argv)

    if args.version:
        print(VERSION)
        return 0

    if hasattr(args, "func"):
        args.func(args)
    else:
        parser.print_help()


if __name__ == '__main__':
    sys.exit(main())
